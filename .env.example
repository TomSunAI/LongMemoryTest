# Copy this file to .env.local and fill in real secrets locally.
# Do not commit .env.local.

POIXE_API_KEY=your-poixe-api-key-here
POIXE_BASE_URL=https://api.poixe.com/v1
POIXE_MODEL=gpt-5.2

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Shared model provider used by A/B when LLM calls are enabled.
# Supported values: poixe, deepseek
LLM_PROVIDER=deepseek

# Local Letta server used by B.
LETTA_BASE_URL=http://127.0.0.1:8283
LETTA_MODEL=openai-proxy/deepseek-v4-pro
LETTA_EMBEDDING=letta/letta-free
