# Copy to .env.letta.local when running the M0 full-retrieval Letta baseline.
# Do not commit real secrets.
#
# This mode is for M0 only. M1/M2/M3 continue to use the handcrafted
# conclusion/summary/detail relational memory JSON files.

# Letta uses an OpenAI-compatible endpoint for embeddings. The current
# DeepSeek/Poixe chat endpoints used by this repo do not return embeddings.
OPENAI_API_KEY=your-openai-or-compatible-embedding-key
OPENAI_API_BASE=https://api.openai.com/v1

# Agent generation model and embedding model registered with Letta.
LETTA_MODEL=openai/gpt-4.1-mini
LETTA_EMBEDDING=openai/text-embedding-3-small

# Turbopuffer is required by Letta message search. Set both naming styles so
# current and future Letta/turbopuffer client versions can resolve them.
USE_TPUF=true
EMBED_ALL_MESSAGES=true
TPUF_API_KEY=your-turbopuffer-key
TPUF_REGION=gcp-us-central1
TURBOPUFFER_API_KEY=your-turbopuffer-key
TURBOPUFFER_REGION=gcp-us-central1

# Runner-side switches. The CLI flag --m0-letta-full-retrieval sets these for
# the dialogue process, but keeping them here is useful for manual smoke tests.
M0_LETTA_ENABLE_MESSAGE_SEARCH=1
M0_LETTA_ENABLE_PASSAGE_SEARCH=1
